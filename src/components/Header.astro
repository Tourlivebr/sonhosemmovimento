---
const { home = false } = Astro.props;
// Remover todo o array todosPasseios daqui - agora será definido no JavaScript
---

<header class:list={{ "home-header": home }} id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 dark:bg-dark-900/50 backdrop-blur-md border-b border-dark-200/20 dark:border-dark-700/20">
  <div class="container mx-auto px-2 lg:px-4">
    <nav class="header-nav flex items-center justify-between h-20 lg:h-28" aria-label="Navegação principal">
      <!-- Logo -->
      <a href="/" class="flex items-center justify-center h-full ml-2 lg:ml-0 group mobile-landscape-hide header-logo" aria-label="Página inicial">
        <img 
          src="/images/logo_sonhosemmovimento.png" 
          alt="Sonhos em Movimento — City Tour e Viagens Exclusivas" 
          class="h-full w-auto max-h-[85%] transition-transform group-hover:scale-105 object-contain"
          width="700"
          height="160"
        />
      </a>
      
      <!-- Search Bar - Desktop -->
      <div class="hidden lg:flex flex-1 max-w-md mx-8 relative items-center mobile-landscape-hide">
        <div class="relative w-full">
          <input 
            type="text" 
            id="search-input"
            placeholder="Buscar passeios ou Ingressos..."
            class="w-full pl-8 pr-4 py-2 border border-dark-300 rounded-lg focus:ring-2 focus:ring-secondary-500 focus:border-transparent transition-all duration-200"
            autocomplete="off"
          />
          <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          
          <!-- Search Results Dropdown -->
          <div id="search-results" class="absolute top-full left-0 right-0 mt-1 bg-white border border-dark-200 rounded-lg shadow-lg max-h-80 overflow-y-auto hidden z-50">
            <!-- Results will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Inline Search - Mobile scrolled (CENTRALIZADO) - Apenas aparece no mobile scrolled -->
      <div class="hidden md:hidden header-scrolled-search flex-1 max-w-[80%] mx-auto justify-center relative">
        <div class="relative w-full">
          <input 
            type="text" 
            id="mobile-scrolled-search-input"
            placeholder="Buscar passeios ou Ingressos..."
            class="w-full pl-8 pr-4 py-2 border border-dark-300 rounded-full focus:ring-2 focus:ring-secondary-500 focus:border-transparent transition-all duration-200 bg-white shadow-sm text-sm"
            autocomplete="off"
          />
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <div id="mobile-scrolled-search-results" class="absolute top-full left-0 right-0 mt-1 bg-white border border-dark-200 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden z-50">
          </div>
        </div>
      </div>
      
      <!-- Desktop Menu -->
      <ul class="hidden md:flex items-center space-x-8 mobile-landscape-hide" role="menubar">
        <li role="none">
          <a 
            href="#quem-sou" 
            class="text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 font-medium transition-colors duration-200 scroll-smooth"
            role="menuitem"
          >
            Início
          </a>
        </li>
        <li role="none" class="relative group">
          <button 
            class="text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 font-medium transition-colors duration-200 flex items-center"
            role="menuitem"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Serviços
            <svg class="w-4 h-4 ml-1 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <!-- Dropdown Menu -->
          <div class="absolute top-full left-0 mt-2 w-64 bg-white dark:bg-dark-800 rounded-lg shadow-xl border border-dark-200 dark:border-dark-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-2">
              <a href="/ingressos" class="block px-4 py-3 text-dark-700 dark:text-dark-300 hover:bg-dark-50 dark:hover:bg-dark-700 hover:text-accent-600 transition-colors">
                <div class="font-medium">Ingressos e Atrações</div>
                <div class="text-sm text-dark-500 dark:text-dark-400">Gramado e Canela</div>
              </a>
              <a href="/passeios" class="block px-4 py-3 text-dark-700 dark:text-dark-300 hover:bg-dark-50 dark:hover:bg-dark-700 hover:text-accent-600 transition-colors">
                <div class="font-medium">Translados e Passeios</div>
                <div class="text-sm text-dark-500 dark:text-dark-400">Tours personalizados</div>
              </a>
            </div>
          </div>
        </li>
        <li role="none">
          <a 
            href="#depoimentos" 
            class="text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 font-medium transition-colors duration-200 scroll-smooth"
            role="menuitem"
          >
            Depoimentos
          </a>
        </li>
        <li role="none">
          <a 
            href="#contato" 
            class="text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 font-medium transition-colors duration-200 scroll-smooth"
            role="menuitem"
          >
            Contato
          </a>
        </li>
      </ul>

      <a class="home-whatsapp hidden md:inline-flex" href="https://wa.me/5551920033127" target="_blank" rel="noopener noreferrer" aria-label="Fale conosco pelo WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.15 1.6 5.95L0 24l6.27-1.64a11.9 11.9 0 0 0 5.8 1.48h.01C18.66 23.84 24 18.5 24 11.92c0-3.18-1.24-6.17-3.48-8.44ZM12.08 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.97.99-3.62-.24-.37a9.86 9.86 0 1 1 8.37 4.61Zm5.42-7.39c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.8-1.49-1.78-1.66-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.5 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.42.25-.7.25-1.3.17-1.42-.08-.12-.27-.2-.57-.35Z"/></svg>
        Fale conosco
      </a>
      
      <div class="hidden mobile-landscape-show flex-1 max-w-md mx-3 relative">
        <div class="relative w-full">
          <input 
            type="text" 
            id="mobile-landscape-search-input"
            placeholder="Buscar passeios ou Ingressos..."
            class="w-full pl-8 pr-4 py-2 border border-dark-300 rounded-lg focus:ring-2 focus:ring-secondary-500 focus:border-transparent transition-all duration-200"
            autocomplete="off"
          />
          <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          
          <div id="mobile-landscape-search-results" class="absolute top-full left-0 right-0 mt-1 bg-white border border-dark-200 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden z-50">
          </div>
        </div>
      </div>

      <!-- Mobile Search Button -->
      <button 
        id="mobile-search-button"
        class="md:hidden lg:hidden p-2 rounded-lg hover:bg-dark-100 dark:hover:bg-dark-800 transition-colors ml-auto mobile-landscape-hide header-mobile-search-btn"
        aria-label="Abrir busca"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>
      
      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg hover:bg-dark-100 dark:hover:bg-dark-800 transition-colors mobile-landscape-menu"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </nav>
    
    <!-- Mobile Search Bar -->
    <div id="mobile-search" class="lg:hidden hidden px-4 pb-4">
      <div class="relative max-w-md mx-auto">
        <input 
          type="text" 
          id="mobile-search-input"
          placeholder="Buscar passeios ou Ingressos..."
          class="w-full pl-8 pr-4 py-2 border border-dark-300 rounded-lg focus:ring-2 focus:ring-secondary-500 focus:border-transparent transition-all duration-200"
          autocomplete="off"
        />
        <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        
        <!-- Mobile Search Results -->
        <div id="mobile-search-results" class="absolute top-full left-0 right-0 mt-1 bg-white border border-dark-200 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden z-50">
          <!-- Results will be populated by JavaScript -->
        </div>
      </div>
    </div>
    
    <!-- Mobile Menu (estrutura e estilo IDENTICOS ao desktop) -->
    <div id="mobile-menu" class="md:hidden hidden bg-white dark:bg-dark-900 border-t border-dark-200 dark:border-dark-700/60 shadow-xl z-[60] absolute w-full left-0 right-0 top-full">
      <div class="container mx-auto px-6 py-6 space-y-5 text-left">
        <a href="#quem-sou" class="block text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors duration-200 font-semibold text-lg mobile-menu-link py-2 border-b border-dark-100 dark:border-dark-700/50 last:border-b-0">Início</a>
        
        <!-- Mobile Services Dropdown (IGUAL desktop dropdown: 2 niveis, titulo + subtitulo, hover primary) -->
        <div class="pb-1 border-b border-dark-100 dark:border-dark-700/50 last:border-b-0">
          <button id="mobile-services-toggle" class="flex items-center justify-between w-full text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors duration-200 font-semibold text-lg py-2">
            Serviços
            <svg class="w-5 h-5 transition-transform text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="mobile-services-menu" class="hidden pl-2 sm:pl-4 mt-2 mb-3 space-y-3 rounded-xl bg-dark-50 dark:bg-dark-800/60 py-3 px-3 border border-dark-200/70 dark:border-dark-700/50 shadow-inner">
            <a href="/ingressos" class="block px-3 py-3 rounded-lg text-dark-700 dark:text-dark-300 hover:bg-white dark:hover:bg-dark-700/60 hover:text-accent-600 dark:hover:text-accent-400 transition-all duration-200 mobile-menu-link border border-transparent hover:border-primary-100 dark:hover:border-primary-900/40">
              <div class="font-semibold text-base">Ingressos e Atrações</div>
              <div class="text-sm text-dark-500 dark:text-dark-400 mt-1">Gramado e Canela</div>
            </a>
            <a href="/passeios" class="block px-3 py-3 rounded-lg text-dark-700 dark:text-dark-300 hover:bg-white dark:hover:bg-dark-700/60 hover:text-accent-600 dark:hover:text-accent-400 transition-all duration-200 mobile-menu-link border border-transparent hover:border-primary-100 dark:hover:border-primary-900/40">
              <div class="font-semibold text-base">Translados e Passeios</div>
              <div class="text-sm text-dark-500 dark:text-dark-400 mt-1">Tours personalizados</div>
            </a>
          </div>
        </div>
        
        <a href="#depoimentos" class="block text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors duration-200 font-semibold text-lg mobile-menu-link py-2 border-b border-dark-100 dark:border-dark-700/50">Depoimentos</a>
        <a href="#contato" class="block text-dark-700 dark:text-dark-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors duration-200 font-semibold text-lg mobile-menu-link py-2 border-b border-dark-100 dark:border-dark-700/50">Contato</a>
      </div>
    </div>
  </div>
</header>

<script>
  import servicos from '../data/busca-servicos.json';
  import ingressosHome from '../data/ingressos-home.json';

  const imagensPasseios: Record<string, string> = {
    '/passeio/transfer-grande-desfile-de-natal': '/images/grande-desfile-de-natal/desfile-01.webp',
    '/passeio/transfer-nativitaten': '/images/nativitaten/nativitaten-01.webp',
    '/passeio/transfer-ida-volta-porto-alegre': '/images/Transfer/transfer.png',
    '/passeio/city-tour-privativo': '/images/transfer11.jpg',
    '/passeio/transporte-olivas': '/images/olivas/olivas_card.jpg',
    '/passeio/transporte-jolimont': '/images/jolimont/jolimont.jpg',
    '/passeio/transporte-sky-glass': '/images/skyglass/skyglass.jpg',
    '/passeio/transporte-parque-do-caracol': '/images/Transfer/transfer.png',
    '/passeio/bondinhos-transporte': '/images/bondinhos.avif',
    '/passeio/city-tour-nova-petropolis': '/images/Nova_Petropolis.jpg',
    '/passeio/lumni-transporte': '/images/lumini.webp',
    '/passeio/maria-fumaca': '/images/maria-fumaca/fumaca01.jpg',
    '/passeio/tour-vinhos-e-sabores': '/images/jolimont/Jolimont1.png',
  };
  const todosPasseios = [
    ...servicos.map(item => ({ ...item, imagem: imagensPasseios[item.href], externo: false })),
    ...ingressosHome.map(item => ({
      titulo: item.titulo,
      subtitulo: item.subtitulo,
      categoria: 'INGRESSOS E ATRAÇÕES',
      href: item.linkOficial,
      imagem: item.imagem,
      externo: true,
    })),
  ];
  const normalizeSearch = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  // Header scroll behavior
  const header = document.getElementById('header');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');
  const mobileServicesToggle = document.getElementById('mobile-services-toggle');
  const mobileServicesMenu = document.getElementById('mobile-services-menu');
  const mobileSearchButton = document.getElementById('mobile-search-button');
  const mobileSearch = document.getElementById('mobile-search');
  const searchInput = document.getElementById('search-input');
  const mobileSearchInput = document.getElementById('mobile-search-input');
  const mobileLandscapeSearchInput = document.getElementById('mobile-landscape-search-input');
  const mobileScrolledSearchInput = document.getElementById('mobile-scrolled-search-input');
  const searchResults = document.getElementById('search-results');
  const mobileSearchResults = document.getElementById('mobile-search-results');
  const mobileLandscapeSearchResults = document.getElementById('mobile-landscape-search-results');
  const mobileScrolledSearchResults = document.getElementById('mobile-scrolled-search-results');
  
  let isMenuOpen = false;
  let isServicesOpen = false;
  let isMobileSearchOpen = false;
  
  // Search functionality
  function performSearch(query, resultsContainer) {
    if (!resultsContainer) return;
    
    if (!query.trim()) {
      resultsContainer.classList.add('hidden');
      return;
    }
    
    const terms = normalizeSearch(query.trim()).split(/\s+/);
    const filteredPasseios = todosPasseios.filter(passeio => {
      const text = normalizeSearch(`${passeio.titulo} ${passeio.subtitulo} ${passeio.categoria}`);
      return terms.every(term => text.includes(term));
    });
    if (filteredPasseios.length === 0) {
      const message = document.createElement('div');
      message.className = 'p-4 text-dark-500 text-center';
      message.textContent = 'Nenhum serviço encontrado para "' + query + '"';
      resultsContainer.replaceChildren(message);
    } else {
      resultsContainer.innerHTML = filteredPasseios.map(passeio => {
        const href = passeio.href;
        const target = passeio.externo ? ' target="_blank" rel="noopener noreferrer"' : '';
        const image = passeio.imagem
          ? `<img src="${passeio.imagem}" alt="" class="h-12 w-14 shrink-0 rounded-md object-cover" loading="lazy" />`
          : `<span class="grid h-12 w-14 shrink-0 place-items-center rounded-md bg-primary-50 text-primary-700" aria-hidden="true">${passeio.externo ? '🎟' : '↗'}</span>`;
        return `
          <a href="${href}"${target} class="flex items-center gap-3 p-3 hover:bg-dark-50 transition-colors border-b border-dark-100 last:border-b-0">
            ${image}
            <span class="min-w-0">
              <span class="block truncate font-medium text-dark-800">${passeio.titulo}</span>
              <span class="block truncate text-sm text-dark-600">${passeio.subtitulo || ''}</span>
              <span class="mt-1 block text-xs text-secondary-600">${passeio.categoria}</span>
            </span>
          </a>
        `;
      }).join('');
    }
    
    resultsContainer.classList.remove('hidden');
  }
  
  const heroSearchInput = document.getElementById('hero-search-input');
  const heroSearchResults = document.getElementById('hero-search-results');
  heroSearchInput?.addEventListener('input', (event) => {
    performSearch((event.target as HTMLInputElement).value, heroSearchResults);
  });
  heroSearchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') heroSearchResults?.classList.add('hidden');
  });
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.hero-search-wrap')) heroSearchResults?.classList.add('hidden');
  });

  // Desktop search
  searchInput?.addEventListener('input', (e) => {
    performSearch(e.target.value, searchResults);
  });
  
  // Mobile search
  mobileSearchInput?.addEventListener('input', (e) => {
    performSearch(e.target.value, mobileSearchResults);
  });

  mobileLandscapeSearchInput?.addEventListener('input', (e) => {
    performSearch(e.target.value, mobileLandscapeSearchResults);
  });

  mobileScrolledSearchInput?.addEventListener('input', (e) => {
    performSearch(e.target.value, mobileScrolledSearchResults);
  });
  
  // Hide search results when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('#search-input') && !e.target.closest('#search-results')) {
      searchResults?.classList.add('hidden');
    }
    if (!e.target.closest('#mobile-search-input') && !e.target.closest('#mobile-search-results')) {
      mobileSearchResults?.classList.add('hidden');
    }
    if (!e.target.closest('#mobile-landscape-search-input') && !e.target.closest('#mobile-landscape-search-results')) {
      mobileLandscapeSearchResults?.classList.add('hidden');
    }
    if (!e.target.closest('#mobile-scrolled-search-input') && !e.target.closest('#mobile-scrolled-search-results')) {
      mobileScrolledSearchResults?.classList.add('hidden');
    }
  });
  
  // Mobile search toggle
  mobileSearchButton?.addEventListener('click', () => {
    isMobileSearchOpen = !isMobileSearchOpen;
    
    if (isMobileSearchOpen) {
      header?.classList.add('mobile-search-active');
      mobileScrolledSearchInput?.focus();
    } else {
      header?.classList.remove('mobile-search-active');
      mobileScrolledSearchResults?.classList.add('hidden');
    }
  });

  const mobileLandscapeMq = window.matchMedia('(max-height: 600px) and (orientation: landscape)');
  const syncLandscapeSearch = () => {
    if (!mobileLandscapeMq.matches) return;
    if (isMobileSearchOpen) {
      isMobileSearchOpen = false;
      header?.classList.remove('mobile-search-active');
      mobileScrolledSearchResults?.classList.add('hidden');
    }
  };
  syncLandscapeSearch();
  mobileLandscapeMq.addEventListener?.('change', syncLandscapeSearch);
  
  // Scroll behavior
  window.addEventListener('scroll', () => {
    if (window.scrollY > 0) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
  
  // Mobile menu toggle
  mobileMenuButton?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen) {
      mobileMenu?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      // Reset services menu when closing main menu
      isServicesOpen = false;
      mobileServicesMenu?.classList.add('hidden');
      const arrow = mobileServicesToggle?.querySelector('svg');
      arrow?.classList.remove('rotate-180');
    }
  });
  
  // Mobile services dropdown toggle
  mobileServicesToggle?.addEventListener('click', () => {
    isServicesOpen = !isServicesOpen;
    const arrow = mobileServicesToggle.querySelector('svg');
    
    if (isServicesOpen) {
      mobileServicesMenu?.classList.remove('hidden');
      arrow?.classList.add('rotate-180');
    } else {
      mobileServicesMenu?.classList.add('hidden');
      arrow?.classList.remove('rotate-180');
    }
  });
  
  // Close mobile menu when clicking on links
  mobileMenuLinks.forEach(link => {
    link.addEventListener('click', () => {
      isMenuOpen = false;
      isServicesOpen = false;
      mobileMenu?.classList.add('hidden');
      mobileServicesMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      const arrow = mobileServicesToggle?.querySelector('svg');
      arrow?.classList.remove('rotate-180');
    });
  });
  
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      
      const href = this instanceof HTMLElement ? this.getAttribute('href') : null;
      const target = href ? document.querySelector(href) : null;
      
      if (target) {
        const headerElement = document.getElementById('header');
        const headerHeight = headerElement?.offsetHeight || 0;
        const targetPosition = target.offsetTop - headerHeight - 20;
        
        window.scrollTo({
          top: Math.max(0, targetPosition),
          behavior: 'smooth'
        });
        
        // Hide search results after navigation
        searchResults?.classList.add('hidden');
        mobileSearchResults?.classList.add('hidden');
        mobileLandscapeSearchResults?.classList.add('hidden');
        mobileScrolledSearchResults?.classList.add('hidden');
      }
    });
  });
</script>

